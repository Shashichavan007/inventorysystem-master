# ScaleFlow Environment Variables Example

PROJECT_NAME=ScaleFlow
DEV_MODE=false # Set to "in_memory" only for isolated unit tests without Kafka

# Databases
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scaleflow
POSTGRES_PASSWORD=scaleflow_pass
POSTGRES_DB=scaleflow_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET_KEY=scaleflow_super_secret_jwt_key_32_bytes_long_12345
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
